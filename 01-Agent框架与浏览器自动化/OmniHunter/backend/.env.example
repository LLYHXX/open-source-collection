# ===== LLM（必填）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# auto / openai_chat / anthropic_messages
LLM_PROTOCOL=auto
# 工具调用兼容：auto(原生优先,失败切提示词) / prompt(强制模拟) / native(仅原生)
TOOL_COMPAT=auto

# ===== 资产测绘（推荐，至少一个）=====
FOFA_KEY=
FOFA_BASE_URL=https://fofa.info
QUAKE_KEY=
HUNTER_KEY=
ZOOMEYE_KEY=
SHODAN_KEY=
CENSYS_KEY=

# ===== 平台 =====
# 控制台全权令牌，不设则任何人可访问；建议填随机串
API_TOKEN=
HOST_PORT=18800
DATABASE_URL=sqlite:///./data/aififteen_hunter.db

# ===== Worker 调度（借鉴 LoopX quota/关卡）=====
WORKER_CONCURRENCY=3
WORKER_STEP_BUDGET=40
WORKER_TIMEOUT=1800
REVIEWER_STRICT=true

# ===== 浏览器自动化（借鉴 Nanobrowser Planner/Navigator/Validator）=====
BROWSER_ENABLED=true
BROWSER_HEADLESS=true

# ===== 安全 =====
WAF_ENABLED=true
CORS_ORIGINS=*

# ===== 自研检测引擎（确定性规则优先，LLM 只做兜底）=====
ENGINE_PLUGIN_TIMEOUT=300
ENGINE_REQUEST_TIMEOUT=10
ENGINE_MAX_CONCURRENCY=4
ENGINE_WEAKPWD_ENABLED=false
ENGINE_UPLOAD_PROBE=false
